<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tasknest</groupId>
    <artifactId>tasknest</artifactId>
    <version>1.0.0</version>

    <packaging>war</packaging>

    <name>project-4-tomcat</name>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <sonar.projectKey>tasknest</sonar.projectKey>
        <sonar.projectName>tasknest</sonar.projectName>
        <sonar.host.url>http://44.201.202.122:8081/</sonar.host.url>
    </properties>

    <!-- Servlet API for Tomcat 9 -->
    <dependencies>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>

            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>5.1.0.4751</version>
            </plugin>

        </plugins>
    </build>
     <distributionManagement>
    <repository>
      <id>nexus-releases</id>
      <url>http://44.201.202.122:8081/repository/maven-releases/</url>
    </repository>
    <snapshotRepository>
      <id>nexus-snapshots</id>
      <url>http://44.201.202.122:8081/repository/maven-snapshots/</url>
    </snapshotRepository>
  </distributionManagement>

</project>
